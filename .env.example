HOST=0.0.0.0
PORT=8787
MANUAL_HTTPS=1
# Paid disk configuration. Use preview mode 1 only for disposable test environments.
MANUAL_PREVIEW_MODE=0
MANUAL_DATA_DIR=/var/data
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_NAME=Administrator
# Set INITIAL_ADMIN_PASSWORD securely in Render, not in source control.
# Attach the persistent disk at MANUAL_DATA_DIR before using this configuration.
